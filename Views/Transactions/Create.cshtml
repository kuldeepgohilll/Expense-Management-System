@model Transaction
@{ViewData["Title"]="Add Transaction";}
<div class="form-card card shadow-sm p-4"><h2 class="h4 fw-bold">Add transaction</h2>
<form asp-action="Create" method="post" class="row g-3 mt-1"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-6"><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select"><option>Expense</option><option>Income</option></select></div>
<div class="col-md-6"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" step=".01"><span asp-validation-for="Amount" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option>Food</option><option>Transport</option><option>Shopping</option><option>Bills</option><option>Entertainment</option><option>Health</option><option>Education</option><option>Travel</option><option>Salary</option><option>Freelance</option><option>Other</option></select></div>
<div class="col-md-6"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" class="form-select"><option>UPI</option><option>Cash</option><option>Credit Card</option><option>Debit Card</option><option>Bank Transfer</option><option>Other</option></select></div>
<div class="col-md-6"><label asp-for="TransactionDate" class="form-label"></label><input asp-for="TransactionDate" type="date" class="form-control"></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
<div><button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Index">Cancel</a></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
