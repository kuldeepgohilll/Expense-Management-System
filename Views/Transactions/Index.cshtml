@model List<Transaction>
@{ViewData["Title"]="Transactions";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 fw-bold">Transactions</h1><p class="text-muted">Manage your income and expenses.</p></div><a class="btn btn-primary" asp-action="Create">+ Add transaction</a></div>
<form class="card shadow-sm p-3 mb-4"><div class="row g-2"><div class="col-md-5"><input name="q" class="form-control" placeholder="Search category or description"></div><div class="col-md-3"><select name="type" class="form-select"><option value="">All types</option><option>Income</option><option>Expense</option></select></div><div class="col-md-3"><input name="category" class="form-control" placeholder="Category"></div><div class="col-md-1"><button class="btn btn-outline-primary w-100">Go</button></div></div></form>
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Date</th><th>Type</th><th>Category</th><th>Payment</th><th>Description</th><th>Amount</th><th></th></tr></thead><tbody>
@foreach(var t in Model){<tr><td>@t.TransactionDate.ToString("dd-MM-yyyy")</td><td><span class="badge @(t.Type=="Income"?"text-bg-success":"text-bg-danger")">@t.Type</span></td><td>@t.Category</td><td>@t.PaymentMethod</td><td>@t.Description</td><td>₹@t.Amount.ToString("N2")</td><td><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@t.Id">Edit</a><form class="d-inline" asp-action="Delete" asp-route-id="@t.Id" method="post"><button class="btn btn-sm btn-light text-danger" onclick="return confirm('Delete this transaction?')">Delete</button></form></td></tr>}
@if(!Model.Any()){<tr><td colspan="7" class="text-center py-5 text-muted">No transactions found.</td></tr>}</tbody></table></div></div>
