<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] - Expense Manager</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link href="~/css/site.css" rel="stylesheet"></head><body>
@if(Context.Session.GetInt32("UserId")!=null){
<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top"><div class="container">
<a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-wallet2"></i> Expense Manager</a>
<div class="navbar-nav me-auto"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a><a class="nav-link" asp-controller="Transactions" asp-action="Index">Transactions</a><a class="nav-link" asp-controller="Budget" asp-action="Index">Budget</a></div>
<span class="navbar-text me-3">Hi, @Context.Session.GetString("UserName")</span><a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Logout">Logout</a>
</div></nav>}
<main class="container py-4">@if(TempData["Message"]!=null){<div class="alert alert-success">@TempData["Message"]</div>}@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required:false)</body></html>
